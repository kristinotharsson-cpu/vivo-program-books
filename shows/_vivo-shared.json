  "audienceInfo": [
    {
      "id": "accessibility",
      "title": "Accessibility",
      "body": [
        "Vivo Performing Arts is committed to making every performance welcoming to all patrons. Assistive listening devices are available at every venue. ASL interpretation, audio description, and large-print or braille program books are available on request — please email access@vivoperformingarts.org at least one week in advance.",
        "Wheelchair-accessible seating is available at every venue. Companion seating may be requested at the time of booking. Service animals are welcome. For questions about a specific venue's accessibility features, contact (617) 482-2595."
      ]
    },
    {
      "id": "code-of-conduct",
      "title": "Patron Code of Conduct",
      "body": [
        "Please arrive on time. Late seating is at the discretion of house management and may be held until a suitable break in the program.",
        "Silence all electronic devices before the performance begins. The use of cell phones, smart watches, or other devices that emit light or sound is disruptive to artists and fellow audience members.",
        "Vivo Performing Arts is committed to providing a respectful environment for all patrons, artists, and staff. Disruptive or harmful behavior may result in removal from the venue."
      ]
    },
    {
      "id": "no-photos",
      "title": "No Photos or Recording During Performance",
      "body": [
        "Photography, audio recording, and video recording of any kind are prohibited during the performance. This includes phone cameras and screen captures.",
        "You are welcome to take photos in the lobby, at intermission, and after the curtain call — please tag @vivoperformingarts when you share."
      ]
    }
  ],
