{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "VivoProgramBook",
  "type": "object",
  "required": ["_meta", "cover", "sections"],
  "additionalProperties": true,
  "properties": {
    "_meta": {
      "type": "object",
      "required": ["programType"],
      "additionalProperties": true,
      "properties": {
        "programType": {
          "type": "string",
          "enum": ["dance", "orchestra", "classical", "voice"]
        },
        "parserConfidence": {
          "type": "string",
          "enum": ["high", "medium", "low"]
        },
        "needsReview": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "cover": {
      "type": "object",
      "required": ["title", "venue"],
      "additionalProperties": true,
      "properties": {
        "eyebrow": { "type": "string" },
        "title": { "type": "string", "minLength": 1 },
        "subtitle": { "type": "string" },
        "date": { "type": "string" },
        "time": { "type": "string" },
        "venue": { "type": "string", "minLength": 1 }
      }
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/section" }
    }
  },
  "definitions": {
    "section": {
      "type": "object",
      "required": ["id", "title", "kind"],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "title": { "type": "string" },
        "kind": {
          "type": "string",
          "enum": ["program", "cast", "notes", "roster", "bios", "performance-sponsor", "info", "events", "donors", "welcome"]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "program" } } },
          "then": {
            "required": ["displayStyle", "pieces"],
            "properties": {
              "displayStyle": { "type": "string", "enum": ["centered", "tabular"] },
              "pieces": {
                "type": "array",
                "items": { "$ref": "#/definitions/pieceOrIntermission" }
              }
            }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "bios" } } },
          "then": {
            "required": ["bios"],
            "properties": {
              "bios": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["id", "name"],
                  "additionalProperties": true,
                  "properties": {
                    "id": { "type": "string" },
                    "name": { "type": "string" },
                    "role": { "type": "string" },
                    "body": { "type": "array", "items": { "type": "string" } }
                  }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "roster" } } },
          "then": {
            "required": ["groups"],
            "properties": {
              "groups": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["h", "players"],
                  "properties": {
                    "h": { "type": "string" },
                    "players": { "type": "array", "items": { "type": "string" } }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "pieceOrIntermission": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind"],
          "properties": {
            "kind": { "const": "intermission" },
            "label": { "type": "string" }
          },
          "additionalProperties": true
        },
        {
          "type": "object",
          "additionalProperties": true,
          "not": { "required": ["kind"] }
        }
      ]
    }
  }
}
